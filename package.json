{
  "name": "frontend-ai-auditor",
  "private": true,
  "version": "1.0.0",
  "description": "Inspectra — Frontend AI Auditor: scan rendered frontend, find meaningful UI/UX & responsive issues, generate a copy-ready fix prompt.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node -e \"require('fs').copyFileSync('manifest.json','dist/manifest.json')\"",
    "build:extension": "npm run build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/chrome": "^0.0.280",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.2",
    "vite": "^6.0.0"
  }
}
