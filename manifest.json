{
  "manifest_version": 3,
  "name": "Inspectra — Frontend AI Auditor",
  "short_name": "Inspectra",
  "version": "1.0.0",
  "description": "Scan the rendered frontend, find meaningful UI/UX & responsive issues, and generate a copy-ready fix prompt for your coding AI.",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Inspectra — Frontend AI Auditor",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/scanner.js", "content/overlay.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["sidepanel.html", "assets/*", "icons/*"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
